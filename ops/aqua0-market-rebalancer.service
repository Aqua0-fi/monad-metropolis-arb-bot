[Unit]
PartOf=docker.service
Description=Aqua0 market-rebalancer observe-only worker
Requires=docker.service aqua0-market-rebalancer-network.service
After=docker.service aqua0-market-rebalancer-network.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
ExecStart=/opt/aqua0-market-rebalancer/run-observer-container.sh
ExecStop=/usr/bin/docker stop --time 45 aqua0-market-rebalancer
Restart=on-failure
RestartSec=10
TimeoutStopSec=55

[Install]
WantedBy=multi-user.target
