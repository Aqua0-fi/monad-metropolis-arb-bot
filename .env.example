# Optional RPC overrides. Do not commit real authenticated URLs.
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_AVALANCHE=
# RPC_URL_CELO=
# RPC_URL_POLYGON=
# RPC_URL_MONAD=
# RPC_URL_ROBINHOOD=
# Required for authenticated Aqua0 API access as appropriate for its service identity:
# AQUA0_API_KEY=
# AQUA0_CALLER_TOKEN=
# Only for a separately authorized, configured live deployment:
# MARKET_REBALANCER_OPERATOR_KEY_BASE=

# Optional read-only report listener for the existing admin dashboard.
# Missing token disables report access; no default secret is used.
# REBALANCER_REPORT_TOKEN=
# REBALANCER_REPORT_HOST=127.0.0.1
# REBALANCER_REPORT_PORT=9091
# RPC_URL_ARC=

# The discovery observer only needs the ordinary read-tier credential.
# AQUA0_READ_API_KEY=
# Separate policy-control credential; never reuse a report, operator or admin token.
# REBALANCER_CONTROL_TOKEN=
# Production reads these permitted credentials from a mounted owner-only JSON file.
# REBALANCER_RUNTIME_SECRETS_FILE=
# REBALANCER_HOST_HEALTH_FILE=
# Dedicated KMS signing is configured by ARN/region in settings, not a raw private key.
# AWS_REGION=
# MARKET_REBALANCER_KMS_KEY_ID=
# MARKET_REBALANCER_OPERATOR_ADDRESS=
